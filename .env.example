# Copy this file to .env, replace every placeholder, and keep .env private.
# Compose builds this local image from the current checkout; set a published image only after it exists.
NOTIHARBOR_IMAGE=notiharbor:local
DOCKER_NETWORK=notiharbor-net
DATA_DIR=./data
HOST_PORT=3000
TZ=UTC

# Use MySQL and Redis instances already attached to DOCKER_NETWORK.
# SQL_DSN format: user:password@tcp(host:3306)/notiharbor?charset=utf8mb4&parseTime=True&loc=UTC
SQL_DSN=notiharbor:replace-this@tcp(mysql:3306)/notiharbor?charset=utf8mb4&parseTime=True&loc=UTC
REDIS_CONN_STRING=redis://:replace-this@redis:6379/0

# Generate stable values before the first start; keep them in a password manager.
# openssl rand -base64 48
SESSION_SECRET=REPLACE_WITH_A_STABLE_RANDOM_VALUE_AT_LEAST_32_BYTES_LONG
# openssl rand -base64 32
ENCRYPTION_KEY=REPLACE_WITH_BASE64_FOR_EXACTLY_32_RANDOM_BYTES
# Cookie Session supports Redis ACL usernames and TLS URLs; Redis Session supports nonzero logical DBs.
SESSION_STORE=cookie
APP_PUBLIC_URL=https://notify.example.net
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
# Leave empty unless the app must trust a reverse proxy. Use only its exact IP/CIDR.
TRUSTED_PROXIES=

# Used only if the database has no users yet. Password must be at least 12 characters.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARACTERS

# Gateway SQL log retention; set either value to 0 to disable that cleanup.
DELIVERY_LOG_RETENTION_DAYS=90
AUDIT_LOG_RETENTION_DAYS=365
